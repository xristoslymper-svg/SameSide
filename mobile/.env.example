EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Native development builds must use an allowlisted custom-scheme callback.
EXPO_PUBLIC_NATIVE_AUTH_REDIRECT_URL=sameside://auth/callback
# Local QA only: exposes the development password sign-in control. Keep false or omit it for normal builds.
EXPO_PUBLIC_ENABLE_DEV_PASSWORD_SIGN_IN=false
# Isolated localhost-only demo. Omit/disable in normal builds.
EXPO_PUBLIC_ENABLE_DEMO=false
