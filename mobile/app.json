{
  "expo": {
    "name": "Same Side",
    "slug": "same-side",
    "scheme": "sameside",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
